# ============================================================
# Beall's List check — settings
# ============================================================
# The FAST check (rules only), the data-quality checks, and the optional
# Crossref cross-check need NO keys at all. You only need an LLM key for the
# THOROUGH check (the optional LLM pass over the "review" papers).

# Optional: your email puts Crossref lookups in its faster, more reliable
# "polite pool" (recommended for large runs so DOI checks aren't throttled).
# CROSSREF_MAILTO=you@example.com

# LLM provider — switch backends without touching code.
# Supported: azure | openai | anthropic | mistral | ollama | gemini
LLM_PROVIDER=azure

# Model / deployment name(s) for whichever provider is active. A single name is
# normal; if you give a JSON array, this check uses the first one.
#   AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ------------------------------------------------------------
# Azure OpenAI  (LLM_PROVIDER=azure)
# ------------------------------------------------------------
OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ------------------------------------------------------------
# OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# Mistral / Gemini / Ollama
# ------------------------------------------------------------
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
