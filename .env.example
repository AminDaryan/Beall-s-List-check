# ============================================================
# Beall's List check — settings
# ============================================================
# The FAST check (rules only), the data-quality checks, and the optional
# Crossref cross-check need NO keys at all. You only need an LLM key for the
# THOROUGH check (the optional LLM pass over the "review" papers).

# Optional: your email puts Crossref lookups in its faster, more reliable
# "polite pool" (recommended for large runs so DOI checks aren't throttled).
# CROSSREF_MAILTO=you@example.com

# LLM provider — switch backends without touching code.
# Supported: azure | openai | anthropic | mistral | ollama | gemini
#
# This is the DEFAULT, not the last word: the web app's Step 3 picks a provider
# and a model per run, and sets both in the environment of the check it starts.
# What is here is where that picker begins, and what a command-line run uses.
LLM_PROVIDER=azure

# Model / deployment name(s) for whichever provider is active. A single name is
# normal; a comma-separated list or a JSON array offers all of them in the web
# app's picker, and a command-line run uses the first.
#   AZURE_OPENAI_DEPLOYMENT=gpt-4o
#   AZURE_OPENAI_DEPLOYMENT=gpt-4o,gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Optional: names to offer for the OTHER providers, so switching provider in the
# web app also switches the list of models it offers. Same three shapes as
# above. Only needed for a provider that LLM_PROVIDER does not select — that one
# takes its names from AZURE_OPENAI_DEPLOYMENT. Nothing here is a limit: Step 3
# also accepts a model name typed in.
#   LLM_MODELS_OPENAI=gpt-4o,gpt-4o-mini
#   LLM_MODELS_ANTHROPIC=claude-3-5-sonnet-20241022
#   LLM_MODELS_OLLAMA=llama3.1

# ------------------------------------------------------------
# Azure OpenAI  (LLM_PROVIDER=azure)
# ------------------------------------------------------------
OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ------------------------------------------------------------
# OpenAI  (LLM_PROVIDER=openai)
# ------------------------------------------------------------
# OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ------------------------------------------------------------
# Anthropic  (LLM_PROVIDER=anthropic)
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=claude-3-5-sonnet-20241022

# ------------------------------------------------------------
# Mistral / Gemini / Ollama
# ------------------------------------------------------------
# MISTRAL_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
