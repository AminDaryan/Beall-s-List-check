# Excel lock files (the vendored snapshot + any tracked .xlsx are kept)
~$*.xlsx
~$*.xls

# Secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]

# Generated output workbooks (the vendored bealls_snapshot.json IS tracked)
src/bealls_list_check/results/

# Input corpus: Semantic Scholar dump JSON files (large; not committed)
docs/

# Journal lists downloaded by the web app's Settings page (ui/venues/doaj.py and
# crossref.py) plus the preference recording which of them to search locally -
# generated per machine, refetched when stale, and never part of the repository.
# Both paths: the cache moved into ui/venues/ with the folder-per-feature split,
# and this rule did not follow it, which put a 3.6 MB DOAJ list into a commit.
ui/.cache/
ui/venues/.cache/

# Third-party reference-list snapshots fetched by the user, NOT redistributed.
# Kscien states "Copyright (c) 2026 Kscien - All Rights Reserved" and publishes
# no licence, so their data must not be committed. Each user fetches their own
# copy with fetch_kscien/fetch_kscien.py. (The Beall's snapshot above IS tracked.)
src/bealls_list_check/data/kscien_snapshot.json
